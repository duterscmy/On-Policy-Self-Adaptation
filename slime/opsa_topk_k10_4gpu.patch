+@torch.no_grad()
+def _compute_topk_outside_mask(
+    logits: torch.Tensor,
+    target_tokens: torch.Tensor,
+    *,
+    top_k: int,
+    vocab_size: int | None,
+    tp_group,
+) -> torch.Tensor:
+    """Return 1 where the sampled target is outside the actor's global Top-K.
+
+    The vocabulary is tensor-parallel sharded. We only inspect each shard's
+    local Top-K values, which is sufficient to determine whether at least K
+    vocabulary logits are strictly larger than the sampled token logit.
+    """
+    if top_k <= 0:
+        raise ValueError(f"top_k must be positive, got {top_k}.")
+
+    tp_size = mpu.get_tensor_model_parallel_world_size()
+    tp_rank = mpu.get_tensor_model_parallel_rank()
+    local_vocab_size = logits.size(-1)
+    padded_vocab_size = local_vocab_size * tp_size
+    effective_vocab_size = int(vocab_size or padded_vocab_size)
+    effective_vocab_size = min(effective_vocab_size, padded_vocab_size)
+
+    if top_k >= effective_vocab_size:
+        return torch.zeros(target_tokens.shape, dtype=torch.float32, device=logits.device)
+
+    vocab_start = tp_rank * local_vocab_size
+    valid_local_vocab = max(0, min(local_vocab_size, effective_vocab_size - vocab_start))
+
+    target_is_local = (target_tokens >= vocab_start) & (target_tokens < vocab_start + valid_local_vocab)
+    local_target_logits = torch.zeros(target_tokens.shape, dtype=logits.dtype, device=logits.device)
+    if valid_local_vocab > 0 and target_is_local.any():
+        local_target_ids = target_tokens[target_is_local] - vocab_start
+        local_target_logits[target_is_local] = logits[target_is_local, local_target_ids]
+
+    if tp_size > 1:
+        dist.all_reduce(local_target_logits, op=dist.ReduceOp.SUM, group=tp_group)
+
+    if valid_local_vocab > 0:
+        local_k = min(top_k, valid_local_vocab)
+        local_topk_values = torch.topk(logits[:, :valid_local_vocab], k=local_k, dim=-1, sorted=False).values
+        local_num_greater = (local_topk_values > local_target_logits.unsqueeze(-1)).sum(dim=-1, dtype=torch.int32)
+    else:
+        local_num_greater = torch.zeros(target_tokens.shape, dtype=torch.int32, device=logits.device)
+
+    if tp_size > 1:
+        dist.all_reduce(local_num_greater, op=dist.ReduceOp.SUM, group=tp_group)
+
+    # Strictly more than K is unnecessary: if K or more tokens have larger
+    # logits, the sampled token's 1-indexed rank is > K.
+    return (local_num_greater >= top_k).to(dtype=torch.float32)
 
 
