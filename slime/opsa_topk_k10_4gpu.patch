--- /dev/null
+++ b/slime/tests/test_opsa_topk.py
@@ -0,0 +1,77 @@
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from slime.backends.megatron_utils.opsa import compute_opsa, validate_opsa_args
+
+
+def _args(**overrides):
+    values = {
+        "advantage_estimator": "opsa",
+        "use_opd": False,
+        "normalize_advantages": False,
+        "use_rollout_logprobs": False,
+        "use_rollout_entropy": False,
+        "kl_coef": 0.0,
+        "use_kl_loss": False,
+        "entropy_coef": 0.0,
+        "opsa_token_fraction": 0.2,
+        "opsa_advantage_min": -1.0,
+        "opsa_advantage_max": -0.5,
+        "opsa_mode": "topk",
+        "opsa_fixed_advantage": -0.5,
+        "opsa_top_k": 10,
+    }
+    values.update(overrides)
+    return SimpleNamespace(**values)
+
+
+def test_topk_mode_selects_only_valid_tokens_outside_topk():
+    output = compute_opsa(
+        [torch.tensor([-3.0, -2.0, -1.0, -0.5])],
+        [torch.tensor([1.0, 1.0, 0.0, 1.0])],
+        token_fraction=0.2,
+        mode="topk",
+        topk_outside_masks=[torch.tensor([0.0, 1.0, 1.0, 1.0])],
+        fixed_advantage=-0.5,
+    )
+
+    assert torch.equal(output.loss_masks[0], torch.tensor([0.0, 1.0, 0.0, 1.0]))
+    assert torch.equal(output.advantages[0], torch.tensor([0.0, -0.5, 0.0, -0.5]))
+    assert output.metrics["opsa/selected_fraction"].item() == pytest.approx(2 / 3)
+
+
+def test_topk_mode_can_select_nothing():
+    output = compute_opsa(
+        [torch.tensor([-3.0, -2.0])],
+        [torch.ones(2)],
+        token_fraction=0.2,
+        mode="topk",
+        topk_outside_masks=[torch.zeros(2)],
+        fixed_advantage=-0.5,
+    )
+
+    assert torch.equal(output.loss_masks[0], torch.zeros(2))
+    assert torch.equal(output.advantages[0], torch.zeros(2))
+
+
+@pytest.mark.parametrize(
+    "overrides",
+    [
+        {"opsa_top_k": 0},
+        {"opsa_fixed_advantage": 0.0},
+        {"opsa_fixed_advantage": 0.2},
+        {"entropy_coef": 0.01},
+        {"use_rollout_entropy": True},
+    ],
+)
+def test_topk_mode_rejects_invalid_configuration(overrides):
+    with pytest.raises(ValueError):
+        validate_opsa_args(_args(**overrides))
+
+
+def test_topk_mode_disables_entropy():
+    args = _args()
+    validate_opsa_args(args)
+    assert args.use_rollout_entropy is False
