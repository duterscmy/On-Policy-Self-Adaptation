@@ -0,0 +1,71 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Run the two main controlled experiments sequentially on the same 4-GPU layout:
+#   1) official OPSA selection: lowest 20% actor-logprob tokens + entropy-adaptive negative advantage
+#   2) proposed Top-K suppression: sampled-token rank > K, fixed negative advantage
+#
+# Defaults are chosen from the Top-K violation analysis:
+#   K=10, fixed advantage=-0.5.
+#
+# Required environment variables are the same as run_opsa.sh, plus OUTPUT_ROOT.
+#
+# Example:
+#   export HF_CHECKPOINT=/path/to/Qwen3-1.7B
+#   export ACTOR_CHECKPOINT=/path/to/qwen3-1.7b-megatron
+#   export PROMPT_DATA=/path/to/dapo-math-17k.jsonl
+#   export EVAL_DATA=/path/to/aime-2024.jsonl
+#   export MEGATRON_PATH=/path/to/Megatron-LM
+#   export OUTPUT_ROOT=/path/to/outputs/qwen3-1.7b_k10
+#   bash examples/opsa/run_k10_vs_opsa_4gpu.sh
+#
+# MODEL can be qwen3-1.7b or qwen3-4b.
+# Any extra CLI arguments are forwarded to run_opsa.sh (e.g. --dry-run).
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+MODEL="${MODEL:-qwen3-1.7b}"
+TOP_K="${TOP_K:-10}"
+TOPK_ADVANTAGE="${TOPK_ADVANTAGE:--0.5}"
+OPSA_FRACTION="${OPSA_FRACTION:-0.2}"
+OUTPUT_ROOT="${OUTPUT_ROOT:?Please set OUTPUT_ROOT}"
+
+mkdir -p "${OUTPUT_ROOT}"
+
+case "${MODEL}" in
+  qwen3-1.7b|qwen3-4b)
+    ;;
+  *)
+    echo "run_k10_vs_opsa_4gpu.sh currently supports qwen3-1.7b and qwen3-4b." >&2
+    exit 2
+    ;;
+esac
+
+echo "============================================================"
+echo "[1/2] OPSA baseline | model=${MODEL} | 4 GPUs (2 actor + 2 rollout)"
+echo "============================================================"
+ACTOR_GPUS=2 ROLLOUT_GPUS=2 \
+bash "${SCRIPT_DIR}/run_opsa.sh" \
+  --model "${MODEL}" \
+  --preset opsa \
+  --fraction "${OPSA_FRACTION}" \
+  --save-dir "${OUTPUT_ROOT}/opsa" \
+  "$@"
+
+echo "============================================================"
+echo "[2/2] Top-K suppression | model=${MODEL} | K=${TOP_K} | A=${TOPK_ADVANTAGE}"
+echo "      4 GPUs (2 actor + 2 rollout)"
+echo "============================================================"
+ACTOR_GPUS=2 ROLLOUT_GPUS=2 \
+bash "${SCRIPT_DIR}/run_opsa.sh" \
+  --model "${MODEL}" \
+  --preset topk \
+  --top-k "${TOP_K}" \
+  --topk-advantage "${TOPK_ADVANTAGE}" \
+  --save-dir "${OUTPUT_ROOT}/topk_k${TOP_K}" \
+  "$@"
+
+echo "============================================================"
+echo "Done."
+echo "OPSA:  ${OUTPUT_ROOT}/opsa"
+echo "Top-K: ${OUTPUT_ROOT}/topk_k${TOP_K}"
+echo "============================================================"
